{
  "name": "@my/react",
  "version": "0.1.0",
  "description": "React UI 컴포넌트 — 접근성과 인터랙션 테스트를 내장한 디자인 시스템 컴포넌트",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leejpsd/my-design-system.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@my/tokens": "workspace:*",
    "@my/core": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
